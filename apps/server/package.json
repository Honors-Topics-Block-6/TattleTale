{
  "name": "@tattletale/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "smoke:socket": "node scripts/socket-smoke.mjs",
    "redis:get": "node scripts/redis-get.mjs",
    "redis:del": "node scripts/redis-get.mjs del",
    "redis:del-pattern": "node scripts/redis-get.mjs del-pattern",
    "prisma:generate": "prisma generate",
    "test": "vitest run --pool=threads --maxWorkers=1"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@prisma/client": "^6.6.0",
    "@tattletale/shared": "file:../../packages/shared",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.1",
    "socket.io": "^4.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "prisma": "^6.6.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
