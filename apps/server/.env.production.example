NODE_ENV=production
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
WEB_ORIGIN=https://game.example.com
TRUST_PROXY=true
ENABLE_STATIC_WEB=true
# Optional absolute path override for built frontend assets.
# STATIC_WEB_DIR=/opt/tattletale/apps/web/dist
ENABLE_PLAYTEST_ROUTES=true
SHUTDOWN_TIMEOUT_MS=15000
CHAT_MAX_LENGTH=500
CHAT_RATE_LIMIT_WINDOW_MS=5000
CHAT_RATE_LIMIT_MAX_MESSAGES=8
DATABASE_URL=postgresql://user:password@host-pooler:5432/tattletale?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/tattletale?sslmode=require
REDIS_URL=redis://default:password@127.0.0.1:6379
